{
  "name": "chembomb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node scripts/local.mjs",
    "build": "tsc --noEmit && vite build && node scripts/worker-build.mjs",
    "build:vercel": "tsc --noEmit && vite build --outDir dist-vercel",
    "start": "node scripts/local.mjs --production",
    "test": "node --test"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.2.7",
    "@fontsource/space-mono": "^5.2.8",
    "fflate": "^0.8.2",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist-vercel",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/chembomb?__chembomb_route=:path*"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}
